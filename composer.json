{
  "name": "rmunate/php2js",
  "description": "Effortlessly share PHP Laravel values with external JavaScript files using just one command, thanks to the seamless integration of PHP2JS.",
  "keywords": [
    "PHP2JS",
    "php2js",
    "toJS",
    "toStrictJS"
  ],
  "homepage": "https://github.com/rmunate/PHP2JS",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Rmunate\\Php2Js\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Raul Mauricio Uñate Castro",
      "email": "raulmauriciounate@gmail.com",
      "role": "owner",
      "homepage": "https://github.com/rmunate"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php --do-not-cache-result --fail-on-deprecation test",
    "analyse": "@php vendor/bin/phpstan analyse --no-progress"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "5.0.x-dev"
    },
    "laravel": {
      "providers": [
        "Rmunate\\Php2Js\\Macros\\Php2JsServiceProvider"
      ]
    }
  }
}
